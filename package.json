{
  "name": "XiaoJuClaw",
  "version": "1.2.13",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "Desktop AI assistant powered by a multi-provider coding agent runtime",
  "repository": {
    "type": "git",
    "url": "https://github.com/anilybing/youclaw"
  },
  "author": {
    "name": "XiaoJuClaw Team",
    "email": "support@xiaojuclaw.top"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "brand-audit": "bun run scripts/brand-audit.ts",
    "version:check": "bun scripts/desktop-version.mjs check",
    "version:set": "bun scripts/desktop-version.mjs set",
    "sbom:check": "bun scripts/generate-sbom.mjs check",
    "sbom:generate": "bun scripts/generate-sbom.mjs write",
    "artifacts:verify": "bun scripts/release-artifacts.mjs verify",
    "validate:recommended-skills": "bun run scripts/validate-recommended-skills.ts",
    "validate:recommended-skills:remote": "bun run scripts/validate-recommended-skills.ts --remote",
    "dev:web": "bun scripts/dev-web.mjs",
    "dev:tauri": "bun tauri dev",
    "dev:tauri:services": "bun scripts/dev-tauri.mjs",
    "build:web": "bun scripts/build-web.mjs",
    "build:sidecar": "bun scripts/build-sidecar.mjs",
    "build:tauri": "bun run build:sidecar && bun tauri build",
    "build:tauri:updater": "bun run build:sidecar && bun tauri build --config src-tauri/tauri.windows-updater.conf.json",
    "build:tauri:no-updater": "bun run build:sidecar && bun tauri build --config src-tauri/tauri.no-updater.conf.json",
    "build:tauri:fast": "bun run build:sidecar && bun tauri build --no-bundle",
    "test": "bun test '.test.'",
    "test:release-evals": "bun test tests/trusted-execution.release.test.ts",
    "test:e2e": "node node_modules/@playwright/test/cli.js test --config e2e/playwright.config.ts --project=desktop-e2e",
    "test:e2e:release": "bun e2e/run-release-smoke.mjs",
    "test:e2e:ui": "node node_modules/@playwright/test/cli.js test --config e2e/playwright.config.ts --project=desktop-e2e --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@cedrugs/pdf-parse": "^1.0.0",
    "@larksuiteoapi/node-sdk": "^1.70.0",
    "@mariozechner/pi-agent-core": "^0.58.0",
    "@mariozechner/pi-ai": "^0.58.0",
    "@mariozechner/pi-coding-agent": "^0.58.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "croner": "^10.0.1",
    "dingtalk-stream": "^2.1.4",
    "fflate": "^0.8.3",
    "grammy": "^1.44.0",
    "hono": "^4.12.28",
    "mammoth": "^1.12.0",
    "minimatch": "^10.2.5",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "playwright-core": "^1.58.2",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "@protobufjs/utf8": "1.1.2",
    "@xmldom/xmldom": "0.8.13",
    "axios": "1.18.1",
    "basic-ftp": "5.3.1",
    "brace-expansion": "5.0.7",
    "fast-uri": "3.1.3",
    "fast-xml-builder": "1.2.1",
    "fast-xml-parser": "5.9.3",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "ip-address": "10.2.0",
    "path-to-regexp": "8.4.2",
    "protobufjs": "7.6.5",
    "qs": "6.15.3",
    "undici": "7.28.0",
    "ws": "8.21.0"
  }
}
