{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "XiaoJuClaw",
  "version": "1.0.0",
  "identifier": "com.xiaojuclaw.app",
  "build": {
    "beforeDevCommand": "bun run dev:tauri:services",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "XiaoJuClaw",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "externalBin": [
      "bin/XiaoJuClaw-server"
    ],
    "resources": [
      "../agents/**/*",
      "../skills/**/*",
      "../prompts/**/*",
      "../src/browser/playwright-runner.js",
      "../node_modules/playwright-core/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "both",
        "languages": ["English", "SimpChinese"],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["xiaojuclaw"]
      }
    },
    "updater": {
      "endpoints": [
        "https://UPDATER_ENDPOINT_PLACEHOLDER/releases/latest.json",
        "https://github.com/CodePhiliaX/XiaoJuClaw/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGNkVEQjU0NTk0REM5MQpSV1NSM0pSRnRlMzJBdWtwUm1oWjdxVjZmS2xHTG1PMHRBZ1l3bThUaXhPZFo4VldBdEpya1U3cwo="
    }
  }
}
