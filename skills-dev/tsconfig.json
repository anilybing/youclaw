{
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["bun-types"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    // 技能脚本是叶子 CLI，行为由 golden 测试兜底；
    // 表格/文档单元格索引访问密集，noUncheckedIndexedAccess 放宽以免噪声。
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true
  },
  "include": ["src", "tests"]
}
